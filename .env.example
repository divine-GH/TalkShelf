# note-brain 环境变量示例（复制为 .env 并填写真实值；.env 不入库）

# DeepSeek API（必填，M1 前；设计文档 §6.1/§9）
DEEPSEEK_API_KEY=

# 联网搜索（DeepSeek 原生 web_search，复用上面的 DEEPSEEK_API_KEY，无需额外 key；§6.5/§22）
# 注：第三方搜索（Tavily/博查/Serper）备选尚未实现（§6.5 预留），无需配置任何搜索 key。

# Ollama 本地 embedding（M2 前；§6.1，模型 bge-m3；⚠️ 变量名以 config.py 为准：
# OLLAMA_URL / EMBED_MODEL，旧名 OLLAMA_BASE_URL / OLLAMA_MODEL 从未被读取）
OLLAMA_URL=http://127.0.0.1:11434
EMBED_MODEL=bge-m3

# 登录（M3；§9/§24：配置 AUTH_PASSWORD 即全局启用登录——页面跳登录页、API 返 401；
# 不配置则登录关闭。密码 argon2 哈希存储于 session 校验，明文不落库）
# AUTH_PASSWORD=请改成你的密码
# AUTH_SESSION_DAYS=30        # 会话有效期（天）
# AUTH_COOKIE_SECURE=0        # 部署 HTTPS 后置 1（本地 http 必须保持 0）
# LOGIN_FAIL_LIMIT=5          # 登录失败阈值（次）
# LOGIN_FAIL_WINDOW=60        # 失败计数窗口（秒）
# LOGIN_LOCK_SECONDS=900      # 达到阈值后锁定时长（秒，默认 15 分钟）
