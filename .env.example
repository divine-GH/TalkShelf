# note-brain 环境变量示例（复制为 .env 并填写真实值；.env 不入库）

# DeepSeek API（必填，M1 前；设计文档 §6.1/§9）
DEEPSEEK_API_KEY=

# 联网搜索（默认走 DeepSeek 原生 web_search，复用上面的 DEEPSEEK_API_KEY，无需额外 key；§6.5/§22）
# 第三方搜索仅作备选：配置 SEARCH_API_KEY 并把 SEARCH_PROVIDER 改为 tavily/bocha/serper
SEARCH_PROVIDER=deepseek
SEARCH_API_KEY=

# Ollama 本地 embedding（M2 前；§6.1，模型 bge-m3）
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=bge-m3
